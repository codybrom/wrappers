# Tokens for authenticated examples (github, threads).
# Copy this file to test/.env and fill in your values.

GITHUB_TOKEN=ghp_your-personal-access-token-here
THREADS_ACCESS_TOKEN=your-access-token-here

# Optional: live write tests for the github example (real POST/PATCH calls).
# Point these at a sandbox repository you own; the harness skips the write
# tests when they are unset. Each run creates one marker-titled issue in the
# repo, updates it, comments on it, and closes it — nothing pre-existing is
# touched.
#GITHUB_WRITE_OWNER=youruser
#GITHUB_WRITE_REPO=sandbox
